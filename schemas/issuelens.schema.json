{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microsoft/IssueLens/blob/main/schemas/issuelens.schema.json",
  "title": "IssueLens repository configuration",
  "description": "Selects repository-relative Markdown instructions for IssueLens triage and planning capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criticality": {
          "$ref": "#/$defs/instructionFile"
        },
        "duplicate_detection": {
          "$ref": "#/$defs/instructionFile"
        },
        "labeling": {
          "$ref": "#/$defs/instructionFile"
        },
        "assignment": {
          "$ref": "#/$defs/instructionFile"
        },
        "notification_content": {
          "$ref": "#/$defs/instructionFile"
        },
        "planning": {
          "$ref": "#/$defs/instructionFile"
        },
        "team_memory": {
          "$ref": "#/$defs/teamMemoryInstruction"
        }
      }
    }
  },
  "$defs": {
    "teamMemoryInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/instructionFile/properties/path"
        },
        "wiki_repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140,
          "description": "GitHub parent repository whose .wiki.git stores team memory; defaults to the source repository. Selects memory scope only; the App installation controls access. Not a URL or Git remote.",
          "pattern": "^(?!.*\\s)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}/(?!\\.{1,2}$)(?![A-Za-z0-9._-]*\\.[gG][iI][tT]$)[A-Za-z0-9._-]{1,100}$"
        }
      }
    },
    "instructionFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Repository-relative POSIX path to a Markdown file. Absolute paths, URLs, backslashes, empty segments, dot segments, queries, and fragments are rejected.",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[?#]).+\\.[mM][dD]$"
        }
      }
    }
  }
}